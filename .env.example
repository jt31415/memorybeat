# Copy to .env and fill in. Everything here is optional -- the game runs, and
# Deezer playlist import works, with none of it set.

# Last.fm: popularity enrichment for `npm run build-packs`.
# Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Spotify playlist import. Both are required together, from
# https://developer.spotify.com/dashboard -- a client id alone is not enough.
# Blank leaves the adapter switched off and /api/playlist/sources reports it as
# unavailable. See server/playlists/spotify.js for the Premium caveat.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------- daily challenge

# Discord sign-in. Both are required together; without them the daily challenge
# switches itself off and the rest of the game runs exactly as before.
#
# From https://discord.com/developers/applications -> New Application -> OAuth2:
#   1. Copy the Client ID and Client Secret in here.
#   2. Add a redirect URI of  <your origin>/auth/discord/callback
#      e.g. http://localhost:3000/auth/discord/callback for local development,
#      and https://your.domain/auth/discord/callback in production. It must
#      match byte for byte or Discord refuses the exchange.
# Only the `identify` scope is requested: an account id, a display name and an
# avatar. No email, no servers, no messages.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The public origin, used to build that redirect URI. Behind a proxy the request
# headers cannot be trusted to reconstruct it, so set this in production. Left
# blank it is read off the request, which is what makes localhost work unset.
PUBLIC_URL=

# Signs the session cookie. Optional: unset, one is generated on first boot and
# kept in the database, which is fine for a single server. Set it explicitly if
# you run more than one instance behind a load balancer -- otherwise each has
# its own key and a session minted by one is rejected by the next.
SESSION_SECRET=

# Salts the daily song schedule. Optional, and it protects nothing but the
# surprise: without it anybody with a copy of this repository can compute
# tomorrow's five songs. Any long random string will do.
DAILY_SALT=
