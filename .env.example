# Copy to .env and fill in. Everything here is optional -- the game runs, and
# Deezer playlist import works, with none of it set.

# Last.fm: popularity enrichment for `npm run build-packs`.
# Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Spotify playlist import. Both are required together, from
# https://developer.spotify.com/dashboard -- a client id alone is not enough.
# Blank leaves the adapter switched off and /api/playlist/sources reports it as
# unavailable. See server/playlists/spotify.js for the Premium caveat.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
