# Copy to deploy.env and fill in. Both deploy scripts read this file if it is
# there, so `./deploy.sh` and `.\deploy.ps1` keep working with no arguments.
#
# deploy.env is gitignored on purpose: where you deploy, and as whom, is not
# something a public repo needs to know.

# The SSH host to deploy to, and the account to do it as.
SERVER_IP=
SERVER_USER=ubuntu

# Port the container is published on. 3000 unless you have a reason.
HOST_PORT=3000
